# Copy values into your runtime environment / Hugging Face Space secrets.
# Remote targets must be HTTPS. Never commit real tokens here.

# SDK gateways
SPYNEL_SDK_HERMES_URL=https://your-hermes-gateway.example/v1/agent

# External agent profiles. Example:
SPYNEL_AGENT_RESEARCHER_URL=https://your-research-agent.example/v1/agent

# Dispatcher behavior
SPYNEL_REQUEST_TIMEOUT=300
SPYNEL_POLL_INTERVAL=2

# Paperclip board manager skill
PAPERCLIP_BASE_URL=https://leon4gr45-paperclip-founder.hf.space
# PAPERCLIP_API_TOKEN=set-as-a-space-secret-if-your-instance-requires-it
# Maximum adaptive idle interval for unchanged semantic goal revisions.
SPYNEL_MAX_POLL_INTERVAL=60
